# ==========================================
# VASAVI EVENTS - Environment Configuration
# ==========================================

# Supabase Public Keys (Required for Supabase Integration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Server-side mutations / admin seed only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App URL (Used for generating absolute QR codes and WhatsApp share URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
